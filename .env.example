# ==========================================
# Spring
# ==========================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080


# ==========================================
# MySQL
# ==========================================

MYSQL_DATABASE=fitness_center_db
MYSQL_USER=fitness_user
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password

DB_URL=jdbc:mysql://mysql:3306/fitness_center_db
DB_USERNAME=fitness_user
DB_PASSWORD=change_this_password

DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000
DB_VALIDATION_TIMEOUT=5000


# ==========================================
# JWT
# ==========================================

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# ==========================================
# Email
# ==========================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password


# ==========================================
# Paystack
# ==========================================

PAYSTACK_BASE_URL=https://api.paystack.co

PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key

PAYSTACK_CALLBACK_URL=https://your-domain.com/api/v1/payments/callback


# ==========================================
# Logging
# ==========================================

LOG_FILE=/app/logs/fitness-management-system.log